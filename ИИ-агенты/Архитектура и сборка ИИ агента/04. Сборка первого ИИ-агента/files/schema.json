{
  "name": "Классификация сообщений с LLM (Ollama → Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "/* Три тестовых сообщения для проверки всех веток */\nreturn [\n  { json: { message: \"Здравствуйте! Подскажите, сколько стоит годовая подписка на ваш сервис?\" } },\n  { json: { message: \"Добрый день! Могу ли я проконсультироваться по поводу интеграции с нашей CRM-системой?\" } },\n  { json: { message: \"Спасибо за быструю доставку, всё работает отлично!\" } }\n];"
      },
      "id": "b0a536ad-8b8b-4176-a6cb-40492d1928a5",
      "name": "Test Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.2.2:11434/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'glm-5.2:cloud', stream: false, format: 'json', messages: [ { role: 'system', content: 'You are a message classifier for a business. Analyze the incoming message and return a JSON object with exactly three fields: \"category\" (must be one of: \"price\", \"consultation\", \"other\"), \"summary\" (brief summary of the message in Russian), \"reply_draft\" (a draft reply in Russian, polite and professional). Return ONLY the JSON object, no markdown, no code fences, no additional text.' }, { role: 'user', content: $json.message } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "eb6d4ca7-9852-4e37-8f95-9a13c31db503",
      "name": "Ollama LLM Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -544,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "/* Парсим ответ Ollama: убираем markdown-обёртки и извлекаем поля */\nconst items = [];\nfor (const item of $input.all()) {\n  const rawContent = item.json.message?.content || '';\n  let cleanJson = rawContent.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '');\n  let parsed;\n  try {\n    parsed = JSON.parse(cleanJson);\n  } catch (e) {\n    const match = rawContent.match(/\\{[\\s\\S]*\\}/);\n    if (match) { try { parsed = JSON.parse(match[0]); } catch (e2) { parsed = {}; } }\n    else { parsed = {}; }\n  }\n  const cat = String(parsed.category || 'other').toLowerCase().trim();\n  const category = ['price','consultation','other'].includes(cat) ? cat : 'other';\n  items.push({\n    json: {\n      message_text: $('Test Messages').item.json.message,\n      category: category,\n      summary: parsed.summary || '',\n      reply_draft: parsed.reply_draft || '',\n      date: new Date().toISOString(),\n      status: 'processed'\n    }\n  });\n}\nreturn items;"
      },
      "id": "8f0e6657-a313-4bfe-9726-0f3b819084d7",
      "name": "Parse LLM Response",
